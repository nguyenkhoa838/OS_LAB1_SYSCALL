+
+uint64 sys_trace(void)
+{
+  int mask;
+  argint(0, &mask);
+
+  struct proc *p = myproc();
+
+  p->trace_mask = mask;
+
+  return 0;
+}
+
+uint64
+sys_sysinfo(void)
+{
+  struct sysinfo info;
+  uint64 addr;
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  info.freemem = get_freemem();
+  info.nproc = get_nproc();
+  info.nopenfiles = get_nopenfiles();
+  
+  if(copyout(p->pagetable, addr, (char *)&info, sizeof(info)) < 0)
+    return -1;
+  return 0;
+}
